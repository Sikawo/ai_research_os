{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/career-job-agent/academic-pi/institution-source-registry.schema.json",
  "title": "Academic PI Institution Source Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "registry_mode", "institutions"],
  "properties": {
    "version": {"const": 1},
    "registry_mode": {"enum": ["offline_only", "pilot", "active"]},
    "selection_basis": {"type": "string", "minLength": 1},
    "source_dataset_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "canonical_records_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "institutions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/institution"}}
  },
  "$defs": {
    "domainArray": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.)+[a-zA-Z]{2,}$"}},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "mode", "adapter", "url", "verification_status"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
        "mode": {"enum": ["discovery_pending", "official_rss", "official_api", "common_ats", "official_page"]},
        "adapter": {"enum": ["unassigned", "rss", "api", "workday", "interfolio", "taleo", "successfactors", "peopleadmin", "pageup", "oracle_hcm", "generic_html", "institution_custom"]},
        "url": {"anyOf": [{"type": "string", "format": "uri"}, {"type": "null"}]},
        "verification_status": {"enum": ["pending", "verified", "rejected"]}
      }
    },
    "institution": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "region_bucket", "country", "official_domains", "priority_tier", "rollout_wave", "batch_id", "cadence_hours", "enabled", "verification_status", "sources"],
      "properties": {
        "id": {"type": "string", "pattern": "^(?:[A-Z]{2}-[0-9]{2}|[a-z0-9][a-z0-9_-]*)$"},
        "name": {"type": "string", "minLength": 1},
        "region_bucket": {"enum": ["US", "EUROPE", "JAPAN", "OTHER"]},
        "country": {"type": "string", "minLength": 2},
        "region_rank": {"type": "integer", "minimum": 1, "maximum": 40},
        "location": {"type": ["string", "null"]},
        "focus_notes": {"type": ["string", "null"]},
        "opening_verification_status": {"enum": ["not_checked", "verified_open", "verified_closed", "uncertain"]},
        "official_domains": {"$ref": "#/$defs/domainArray"},
        "approved_platform_domains": {"$ref": "#/$defs/domainArray"},
        "priority_tier": {"enum": [1, 2, 3, "P1", "P2", "P3"]},
        "rollout_wave": {"enum": [10, 25, 50, 100]},
        "batch_id": {"type": "string", "pattern": "^batch_[0-9]{2}$"},
        "cadence_hours": {"type": "integer", "minimum": 1, "maximum": 48},
        "enabled": {"type": "boolean"},
        "verification_status": {"enum": ["pending", "verified", "rejected"]},
        "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}}
      }
    }
  }
}
