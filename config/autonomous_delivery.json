{
  "schema_version": 1,
  "repository": "ai_research_os",
  "origin_url": "https://github.com/Sikawo/ai_research_os.git",
  "github_repository": "Sikawo/ai_research_os",
  "enabled": true,
  "max_git_level": 4,
  "base_branch": "main",
  "allowed_branch_prefixes": [
    "agent/",
    "codex/"
  ],
  "allowed_task_classes": [
    "documentation",
    "source",
    "tests",
    "config",
    "workflow"
  ],
  "protected_content_mode": "forbidden",
  "blocked_path_patterns": [
    ".env",
    ".env.*",
    "**/.env",
    "**/.env.*",
    "exports/**",
    "ai_artifacts/**",
    "credentials/**",
    "secrets/**",
    "Papers/**",
    "Applications/**",
    "People/**",
    "Protocols/**",
    "Private/**",
    "raw_data/**",
    "RawData/**",
    "data/raw/**",
    "Data/raw/**",
    "**/*.pem",
    "**/*.key",
    "**/*.fcs",
    "**/*.fastq",
    "**/*.fastq.gz",
    "**/*.bam",
    "**/*.cram",
    "**/*.vcf",
    "**/*.vcf.gz",
    "**/*.lif",
    "**/*.czi",
    "**/*.nd2",
    "**/*.tif",
    "**/*.tiff",
    "**/*.h5",
    "**/*.hdf5",
    "**/*.zip",
    "**/*.tar",
    "**/*.tar.gz",
    "**/*.ipynb",
    "**/*.pdf",
    "**/*.doc",
    "**/*.docx"
  ],
  "required_validation_commands": [
    "python3 Scripts/validate_repository_safety.py --phase working-tree",
    "python3 Scripts/run_safety_check.py",
    "python3 -m pytest -q -p no:cacheprovider"
  ],
  "policy_documents": [
    "AGENTS.md",
    "AI_SAFE.md",
    "REPO_PROFILE.md",
    "Docs/codex_autonomous_work_policy.md",
    "shared_core/CORE_AUTONOMOUS_DELIVERY_POLICY.md"
  ],
  "final_review_command": "python3 Scripts/finish_change.py --active-spec",
  "draft_pr_allowed": true,
  "merge_allowed": false,
  "forbid_force_push": true,
  "forbid_branch_delete": true
}
