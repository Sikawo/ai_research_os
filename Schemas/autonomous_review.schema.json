{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/autonomous_review.schema.json",
  "title": "Autonomous Delivery Review Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "verdict",
    "reviewed_paths",
    "reviewed_snapshot_sha256",
    "final_review_packet_sha256",
    "reviewed_base_commit",
    "reviewed_head_commit",
    "pr_body_path",
    "pr_body_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "verdict": {
      "type": "string",
      "enum": ["APPROVE", "REQUEST_CHANGES", "BLOCK"]
    },
    "reviewed_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
      }
    },
    "reviewed_snapshot_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "final_review_packet_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reviewed_base_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "reviewed_head_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "pr_body_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "pr_body_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
