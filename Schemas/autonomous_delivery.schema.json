{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/autonomous_delivery.schema.json",
  "title": "Autonomous Delivery Repository Capability",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "origin_url",
    "github_repository",
    "enabled",
    "max_git_level",
    "base_branch",
    "allowed_branch_prefixes",
    "allowed_task_classes",
    "protected_content_mode",
    "blocked_path_patterns",
    "required_validation_commands",
    "policy_documents",
    "final_review_command",
    "draft_pr_allowed",
    "merge_allowed",
    "forbid_force_push",
    "forbid_branch_delete"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "repository": { "type": "string", "minLength": 1 },
    "origin_url": { "type": "string", "minLength": 1 },
    "github_repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "enabled": { "type": "boolean" },
    "max_git_level": { "type": "integer", "minimum": 0, "maximum": 4 },
    "base_branch": { "type": "string", "minLength": 1 },
    "allowed_branch_prefixes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "allowed_task_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["documentation", "source", "tests", "config", "workflow"]
      }
    },
    "protected_content_mode": {
      "type": "string",
      "enum": ["forbidden", "explicit_exact_scope"]
    },
    "blocked_path_patterns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relativePattern" }
    },
    "required_validation_commands": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "policy_documents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relativePath" }
    },
    "final_review_command": { "type": "string", "minLength": 1 },
    "draft_pr_allowed": { "const": true },
    "merge_allowed": { "const": false },
    "forbid_force_push": { "const": true },
    "forbid_branch_delete": { "const": true }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "relativePattern": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    }
  }
}
