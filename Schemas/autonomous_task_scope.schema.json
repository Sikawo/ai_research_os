{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/autonomous_task_scope.schema.json",
  "title": "Autonomous Delivery Task Scope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "repository",
    "task_class",
    "change_class",
    "requested_git_level",
    "base_branch",
    "branch",
    "allowed_paths",
    "allowed_new_files",
    "review_required_paths",
    "forbidden_paths",
    "protected_content_mode",
    "validation_commands",
    "commit_message",
    "pr_title",
    "pr_body_file",
    "existing_draft_pr_number"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "repository": { "type": "string", "minLength": 1 },
    "task_class": {
      "type": "string",
      "enum": ["documentation", "source", "tests", "config", "workflow"]
    },
    "change_class": {
      "type": "string",
      "enum": ["light", "medium", "heavy"]
    },
    "requested_git_level": { "type": "integer", "minimum": 0, "maximum": 4 },
    "base_branch": { "type": "string", "minLength": 1 },
    "branch": { "type": "string", "minLength": 1 },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relativePattern" }
    },
    "allowed_new_files": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relativePattern" }
    },
    "review_required_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relativePattern" }
    },
    "forbidden_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relativePattern" }
    },
    "protected_content_mode": {
      "type": "string",
      "enum": ["none", "explicit_exact_scope"]
    },
    "validation_commands": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "commit_message": { "type": "string", "minLength": 1 },
    "pr_title": { "type": "string", "minLength": 1 },
    "pr_body_file": { "$ref": "#/$defs/relativePattern" },
    "existing_draft_pr_number": {
      "type": ["integer", "null"],
      "minimum": 1
    }
  },
  "$defs": {
    "relativePattern": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    }
  }
}
